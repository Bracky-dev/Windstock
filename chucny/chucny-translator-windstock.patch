new file mode 100644
index 0000000..ff157c8
--- /dev/null
+++ b/translator/core/android/windstock_hooks.cpp
@@ -0,0 +1,136 @@
+// Windstock additions to Chucny's Translator (AGPL-3.0, same licence as the rest of this tree).
+//
+// Points the game at the Windstock server from inside the JNI bridge: the game's network layer
+// (NiaNet) and Unity's WWW are Java classes the translated engine calls through JNI, and a few
+// hooks hand those calls to our Java (com.windstock.translator64.WsNet) first.
+//   - NiaNet.request(J,I,String url,I,String headers,ByteBuffer,I,I)  -> WsNet.route
+//   - WWW constructors taking a URL                                    -> WsNet.localUrl
+//   - after native NiaNet.nativeSetupConnection(conn)                  -> WsNet.setup(conn)
+#include <jni.h>
+
+#include <cstring>
+#include <mutex>
+#include <string>
+#include <unordered_set>
+#include <vector>
+
+#include "windstock_hooks.h"
+#include "zb/log.h"
+#include "zb/native_thunks.h"
+
+namespace zb {
+
+namespace {
+
+std::mutex g_mu;
+std::unordered_set<jmethodID> g_request, g_www;
+jclass g_wsnet = nullptr;
+jmethodID g_route = nullptr, g_local_url = nullptr, g_setup = nullptr;
+
+std::string class_name(JNIEnv* e, jclass cls) {
+    jclass kc = e->FindClass("java/lang/Class");
+    jmethodID gn = kc ? e->GetMethodID(kc, "getName", "()Ljava/lang/String;") : nullptr;
+    std::string out;
+    if (gn) {
+        auto s = static_cast<jstring>(e->CallObjectMethod(cls, gn));
+        if (s) {
+            const char* c = e->GetStringUTFChars(s, nullptr);
+            if (c) out = c;
+            if (c) e->ReleaseStringUTFChars(s, c);
+            e->DeleteLocalRef(s);
+        }
+    }
+    if (kc) e->DeleteLocalRef(kc);
+    if (e->ExceptionCheck()) e->ExceptionClear();
+    return out;
+}
+
+// positions of 'Ljava/lang/String;' parameters in a method descriptor
+std::vector<int> string_params(const std::string& sig, int* count) {
+    std::vector<int> out;
+    int idx = 0;
+    for (size_t p = 1; p < sig.size() && sig[p] != ')'; ++p, ++idx) {
+        if (sig.compare(p, 18, "Ljava/lang/String;") == 0) out.push_back(idx);
+        while (sig[p] == '[') ++p;
+        if (sig[p] == 'L') p = sig.find(';', p);
+    }
+    *count = idx;
+    return out;
+}
+
+}  // namespace
+
+void windstock_note_method(void* env, void* cls, const char* name, const char* sig, void* id) {
+    if (!g_wsnet || !name || !sig) return;
+    const bool req = !std::strcmp(name, "request") || !std::strcmp(name, "doSyncRequest");
+    const bool init = !std::strcmp(name, "<init>");
+    if (!req && !init) return;
+    JNIEnv* e = static_cast<JNIEnv*>(env);
+    const std::string cn = class_name(e, static_cast<jclass>(cls));
+    std::lock_guard<std::mutex> lock(g_mu);
+    if (req && cn.find("NiaNet") != std::string::npos) {
+        int n = 0;
+        auto s = string_params(sig, &n);
+        if (n == 8 && s.size() >= 2 && s[0] == 2 && s[1] == 4) {
+            g_request.insert(static_cast<jmethodID>(id));
+            log("windstock: routing %s.%s%s", cn.c_str(), name, sig);
+        }
+    } else if (init && (cn == "com.unity3d.player.WWW" || cn.find("UnityWebRequest") != std::string::npos)) {
+        g_www.insert(static_cast<jmethodID>(id));
+        log("windstock: routing %s.<init>%s", cn.c_str(), sig);
+    }
+}
+
+void windstock_before_call(void* env, void* method, void* args_v, const char* sig) {
+    if (!g_wsnet) return;
+    JNIEnv* e = static_cast<JNIEnv*>(env);
+    auto* a = static_cast<jvalue*>(args_v);
+    jmethodID m = static_cast<jmethodID>(method);
+    bool req, www;
+    {
+        std::lock_guard<std::mutex> lock(g_mu);
+        req = g_request.count(m) != 0;
+        www = !req && g_www.count(m) != 0;
+    }
+    if (req && a[2].l) {
+        auto r = static_cast<jobjectArray>(e->CallStaticObjectMethod(g_wsnet, g_route, a[2].l, a[4].l));
+        if (e->ExceptionCheck()) { e->ExceptionDescribe(); e->ExceptionClear(); return; }
+        if (!r) return;
+        a[2].l = e->GetObjectArrayElement(r, 0);
+        a[4].l = e->GetObjectArrayElement(r, 1);
+    } else if (www && sig) {
+        int n = 0;
+        for (int i : string_params(sig, &n)) {
+            if (!a[i].l) continue;
+            jobject to = e->CallStaticObjectMethod(g_wsnet, g_local_url, a[i].l);
+            if (e->ExceptionCheck()) { e->ExceptionClear(); continue; }
+            if (to) a[i].l = to;
+        }
+    }
+}
+
+void windstock_after_native(const char* label, NativeRegs& regs) {
+    if (!g_wsnet || !std::strstr(label, "nativeSetupConnection")) return;
+    JNIEnv* e = reinterpret_cast<JNIEnv*>(static_cast<std::uintptr_t>(regs.x[0]));
+    // static: x1 = class, x2 = the HttpURLConnection; instance: x1 = this, x2 = first argument
+    jobject conn = reinterpret_cast<jobject>(static_cast<std::uintptr_t>(regs.x[2]));
+    jclass hc = e->FindClass("java/net/HttpURLConnection");
+    const bool ok = conn && hc && e->IsInstanceOf(conn, hc);
+    if (hc) e->DeleteLocalRef(hc);
+    if (!ok) { log("windstock: nativeSetupConnection arg is not an HttpURLConnection"); return; }
+    e->CallStaticVoidMethod(g_wsnet, g_setup, conn);
+    if (e->ExceptionCheck()) { e->ExceptionDescribe(); e->ExceptionClear(); }
+}
+
+}  // namespace zb
+
+extern "C" JNIEXPORT void JNICALL Java_com_windstock_translator64_WsHooks_nInit(JNIEnv* env, jclass, jclass wsnet) {
+    using namespace zb;
+    g_wsnet = static_cast<jclass>(env->NewGlobalRef(wsnet));
+    g_route = env->GetStaticMethodID(g_wsnet, "route", "(Ljava/lang/String;Ljava/lang/String;)[Ljava/lang/String;");
+    g_local_url = env->GetStaticMethodID(g_wsnet, "localUrl", "(Ljava/lang/String;)Ljava/lang/String;");
+    g_setup = env->GetStaticMethodID(g_wsnet, "setup", "(Ljava/net/HttpURLConnection;)V");
+    if (env->ExceptionCheck()) { env->ExceptionClear(); g_wsnet = nullptr; }
+    set_native_post_hook(&windstock_after_native);
+    log("windstock: server routing hooks %s", g_wsnet ? "on" : "FAILED");
+}
