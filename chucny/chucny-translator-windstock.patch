+// Windstock additions to Chucny's Translator (AGPL-3.0, same licence as the rest of this tree).
+//
+// Guest hooks + the C surface the in-app Frida agent (work/mods/android-035/t64) drives. The agent
+// runs in the 64-bit host; everything it does to the 32-bit game goes through these exports:
+//
+//   wst_gbase()                         host address of guest address 0
+//   wst_gcall(fn, args, n)              call guest code (r0-r3 + stack), r0|r1<<32 back
+//   wst_gsym(lib, name)                 a guest module's export (Thumb bit kept)
+//   wst_gmodule(lib, &base, &size)      where a guest module sits
+//   wst_galloc(n) / wst_gfree(p)        guest heap (the guest's own calloc/free)
+//   wst_ghook(addr, cb, leave)          patch a guest function's entry -> cb
+//   wst_ghook_orig(id)                  callable copy of the entry (the original)
+//   wst_gunhook(id)
+//
+// A hook overwrites the first 8 bytes of the function with a jump to an SVC stub. The stub hands
+// the registers to the host callback, which either lets the original run (through a trampoline:
+// the relocated first instructions + a jump back) or returns at once with r0/r1 it set. On the
+// hooking thread, a call to the same function made from inside its own callback goes straight to
+// the original, like Frida's Interceptor.replace.
+#include <jni.h>
+#include <sys/mman.h>
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <cstring>
+#include <map>
+#include <mutex>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+#include "zb/library_protocol.h"
+#include "zb/library_runtime.h"
+#include "zb/log.h"
+#include "zb/process.h"
+
+namespace zb {
+
+namespace {
+
+using u8 = std::uint8_t;
+using u16 = std::uint16_t;
+using u32 = std::uint32_t;
+
+constexpr u32 kLeaveIndex = 0xF800;          // svc #(0x5A0000 | index): hook stubs use 0xF801 + id
+constexpr u32 kMaxHooks = 0x2FE;   // indices 0xF801..0xFAFF: below the JNI host calls at 0xFB00
+constexpr u32 kArenaSize = 512 * 1024;
+
+LibraryRuntime* g_rt = nullptr;
+std::mutex g_mu;
+u32 g_arena = 0, g_arena_used = 0;
+
+inline GuestMemory& mem() { return g_rt->memory(); }
+inline u8* H(u32 a) { return mem().base() + a; }
+u16 rd16(u32 a) { u16 v; std::memcpy(&v, H(a), 2); return v; }
+u32 rd32(u32 a) { u32 v; std::memcpy(&v, H(a), 4); return v; }
+
+// Writes into guest memory that may be mapped read-only on the host (code pages).
+void gwrite(u32 a, const void* src, u32 n) {
+    const u32 first = page_round_down(a), last = page_round_down(a + n - 1);
+    std::vector<std::pair<u32, int>> saved;
+    for (u32 p = first;; p += kPageSize) {
+        const u8 f = mem().page_flags(p);
+        int g = ((f & kPageRead) ? PROT_READ : 0) | ((f & kPageWrite) ? PROT_WRITE : 0) | ((f & kPageExec) ? PROT_EXEC : 0);
+        saved.emplace_back(p, host_prot(g));
+        ::mprotect(H(p), kPageSize, PROT_READ | PROT_WRITE);
+        if (p == last) break;
+    }
+    std::memcpy(H(a), src, n);
+    for (auto& s : saved) ::mprotect(H(s.first), kPageSize, s.second);
+}
+void w16(u32 a, u16 v) { gwrite(a, &v, 2); }
+void w32(u32 a, u32 v) { gwrite(a, &v, 4); }
+
+// Executable guest memory for stubs and trampolines (bump allocator, never freed).
+u32 arena_alloc(u32 n) {
+    if (!g_arena) {
+        Process& proc = g_rt->process();
+        std::lock_guard<std::mutex> lock(proc.mm_mutex());
+        g_arena = mem().find_free(kArenaSize, Process::kMmapLimit);
+        if (!g_arena || !mem().map_anon(g_arena, kArenaSize, PROT_READ | PROT_WRITE | PROT_EXEC)) { g_arena = 0; return 0; }
+        // word 0: the leave stub
+        const u32 svc = 0xEF000000u | (0x5A0000u | kLeaveIndex);
+        std::memcpy(H(g_arena), &svc, 4);
+        g_arena_used = 4;
+    }
+    n = (n + 3) & ~3u;
+    if (g_arena_used + n > kArenaSize) return 0;
+    const u32 at = g_arena + g_arena_used;
+    g_arena_used += n;
+    return at;
+}
+
+// ---- relocation of the overwritten entry ----
+struct Emit {
+    std::vector<u8> code;
+    std::vector<std::pair<size_t, u32>> lits;   // (offset of the 32-bit LDR, value)
+    void h(u16 v) { code.push_back(u8(v)); code.push_back(u8(v >> 8)); }
+    void w(u32 v) { for (int i = 0; i < 4; ++i) code.push_back(u8(v >> (8 * i))); }
+};
+
+bool thumb32(u16 hw) { return (hw >> 11) == 0x1D || (hw >> 11) == 0x1E || (hw >> 11) == 0x1F; }
+
+void t_ldr_lit(Emit& e, int rt, u32 value) {   // Thumb LDR.W Rt, [PC, #lit], fixed up later
+    e.lits.emplace_back(e.code.size(), value);
+    e.h(0xF8DF); e.h(u16(rt << 12));
+}
+
+bool reloc_thumb(u32 pc, u32 need, Emit& e, u32* consumed) {
+    u32 off = 0;
+    while (off < need) {
+        u32 a = pc + off;
+        u16 hw = rd16(a);
+        if (thumb32(hw)) {
+            u16 hw2 = rd16(a + 2);
+            if ((hw & 0xFF7F) == 0xF85F) {                     // LDR.W Rt, [PC, #+-imm12]
+                int rt = hw2 >> 12; u32 imm = hw2 & 0xFFF;
+                u32 base = (a + 4) & ~3u;
+                u32 src = (hw & 0x80) ? base + imm : base - imm;
+                t_ldr_lit(e, rt, src);
+                e.h(u16(0xF8D0 | rt)); e.h(u16(rt << 12));    // LDR.W Rt, [Rt]
+            } else if ((hw & 0xF800) == 0xF000 && (hw2 & 0xC000) == 0xC000) {
+                return false;                                  // BL/BLX: not in a prologue we handle
+            } else if ((hw & 0xF800) == 0xF000 && (hw2 & 0x8000) == 0x8000) {
+                return false;                                  // B.W / Bcc.W
+            } else {
+                e.h(hw); e.h(hw2);
+            }
+            off += 4;
+        } else {
+            if (hw == 0x4770 || (hw & 0xFF00) == 0xBD00) {     // BX LR / POP {..,pc}: function ends
+                e.h(hw); off += 2;
+                if (off < need) return false;
+                continue;
+            }
+            if ((hw & 0xF800) == 0x4800) {                     // LDR Rt, [PC, #imm8*4]
+                int rt = (hw >> 8) & 7;
+                u32 src = ((a + 4) & ~3u) + (hw & 0xFF) * 4;
+                t_ldr_lit(e, rt, src);
+                e.h(u16(0x6800 | (rt << 3) | rt));             // LDR Rt, [Rt]
+            } else if ((hw & 0xFF78) == 0x4478) {              // ADD Rdn, PC
+                int rd = (hw & 7) | ((hw >> 4) & 8);
+                t_ldr_lit(e, 12, a + 4);
+                e.h(u16(0x4400 | ((rd & 8) << 4) | (12 << 3) | (rd & 7)));   // ADD Rd, r12
+            } else if ((hw & 0xF800) == 0xA000) {              // ADR Rd, #imm8*4
+                int rd = (hw >> 8) & 7;
+                t_ldr_lit(e, rd, ((a + 4) & ~3u) + (hw & 0xFF) * 4);
+            } else if ((hw & 0xF000) == 0xD000 || (hw & 0xF800) == 0xE000 || (hw & 0xF500) == 0xB100 ||
+                       ((hw & 0xFF00) == 0xBF00 && (hw & 0xF) != 0) || (hw & 0xFF87) == 0x4687 ||
+                       (hw & 0xFF00) == 0x4700) {
+                return false;                                  // branches, IT blocks, writes to PC
+            } else {
+                e.h(hw);
+            }
+            off += 2;
+        }
+    }
+    *consumed = off;
+    return true;
+}
+
+bool reloc_arm(u32 pc, u32 need, Emit& e, u32* consumed) {
+    for (u32 off = 0; off < need; off += 4) {
+        u32 a = pc + off, i = rd32(a);
+        u32 cond = i >> 28;
+        if (cond == 0xF) return false;
+        if ((i & 0x0F7F0000) == 0x051F0000 && cond == 0xE) {   // LDR Rt, [PC, #+-imm12]
+            int rt = (i >> 12) & 15;
+            if (rt == 15) return false;
+            u32 src = (i & (1u << 23)) ? a + 8 + (i & 0xFFF) : a + 8 - (i & 0xFFF);
+            e.lits.emplace_back(e.code.size(), src);
+            e.w(0xE59F0000u | (u32(rt) << 12));
+            e.w(0xE5900000u | (u32(rt) << 16) | (u32(rt) << 12));
+            continue;
+        }
+        if (i == 0xE12FFF1Eu || (i & 0xFFFF8000u) == 0xE8BD8000u) {   // BX LR / POP {..,pc}
+            e.w(i);
+            if (off + 4 < need) return false;
+            continue;
+        }
+        if ((i & 0xFF000000) == 0xEA000000) {                  // B (always): a PLT-style jump stub
+            const int32_t imm = int32_t(i << 8) >> 6;           // imm24 << 2, sign-extended
+            e.w(0xE51FF004u);                                   // LDR PC, [PC, #-4]
+            e.w(a + 8 + u32(imm));
+            *consumed = need;                                   // nothing after an unconditional jump runs
+            return true;
+        }
+        if ((i & 0x0E000000) == 0x0A000000) return false;      // conditional B / BL
+        bool dp = (i & 0x0C000000) == 0;
+        if (dp && (((i >> 16) & 15) == 15 || ((i >> 12) & 15) == 15 || (!(i & (1u << 25)) && (i & 15) == 15)))
+            return false;
+        if ((i & 0x0C000000) == 0x04000000 && (((i >> 16) & 15) == 15 || ((i >> 12) & 15) == 15))
+            return false;
+        if ((i & 0x0E000000) == 0x08000000 && (i & (1u << 15))) return false;
+        e.w(i);
+    }
+    *consumed = need;
+    return true;
+}
+
+// Builds the trampoline in the arena: relocated entry, jump back, literal pool.
+u32 build_tramp(u32 addr, u32* patched_len) {
+    const bool thumb = addr & 1;
+    const u32 pc = addr & ~1u;
+    Emit e; u32 used = 0;
+    if (thumb) {
+        if (!reloc_thumb(pc, 8, e, &used)) return 0;
+        if (e.code.size() & 2) e.h(0xBF00);
+        e.h(0xF8DF); e.h(0xF000);                              // LDR.W PC, [PC, #0]
+        e.w((pc + used) | 1);
+    } else {
+        if (!reloc_arm(pc, 8, e, &used)) return 0;
+        e.w(0xE51FF004u);                                      // LDR PC, [PC, #-4]
+        e.w(pc + used);
+    }
+    const size_t pool = e.code.size();
+    for (size_t k = 0; k < e.lits.size(); ++k) e.w(0);
+    u32 t = arena_alloc(u32(e.code.size()) + 8);
+    if (!t) return 0;
+    t = (t + 3) & ~3u;
+    std::vector<u8> img = e.code;
+    for (size_t k = 0; k < e.lits.size(); ++k) {
+        const size_t at = e.lits[k].first;
+        const u32 lit = t + u32(pool + 4 * k);
+        if (thumb) {
+            const u32 base = (t + u32(at) + 4) & ~3u;
+            u16 hw2; std::memcpy(&hw2, &img[at + 2], 2);
+            hw2 = u16((hw2 & 0xF000) | (lit - base));
+            std::memcpy(&img[at + 2], &hw2, 2);
+        } else {
+            u32 ins; std::memcpy(&ins, &img[at], 4);
+            ins = (ins & ~0xFFFu) | (lit - (t + u32(at) + 8));
+            std::memcpy(&img[at], &ins, 4);
+        }
+        const u32 v = e.lits[k].second;
+        std::memcpy(&img[pool + 4 * k], &v, 4);
+    }
+    gwrite(t, img.data(), u32(img.size()));
+    *patched_len = used;
+    g_rt->process().invalidate(t, u32(img.size()));
+    return thumb ? (t | 1) : t;
+}
+
+// ---- hooks ----
+// regs: r0..r15, cpsr. Returns 0 = run the original, 1 = return now (r0/r1 as set),
+// 2 = run the original and call back again (kind 1) when it returns. kind: 0 entry, 1 leave.
+using HookCb = int (*)(int id, int kind, u32* regs);
+
+struct Hook {
+    u32 addr = 0, tramp = 0, stub = 0;
+    HookCb cb = nullptr;
+    bool leave = false, live = false;
+    u8 saved[12] = {};
+    u32 saved_len = 0;
+};
+std::vector<Hook> g_hooks;
+
+struct Pending { u32 lr; int id; u32 sp; };
+thread_local std::vector<Pending> t_leave;
+thread_local std::vector<int> t_in_cb;
+
+void regs_out(GuestThread& t, u32* r) {
+    auto& R = t.regs();
+    for (int i = 0; i < 16; ++i) r[i] = R[i];
+    r[16] = t.cpsr();
+}
+void regs_in(GuestThread& t, const u32* r) {
+    auto& R = t.regs();
+    for (int i = 0; i < 13; ++i) R[i] = r[i];
+    R[14] = r[14];
+}
+void jump(GuestThread& t, u32 target) {
+    t.set_cpsr((t.cpsr() & ~0x20u) | ((target & 1) ? 0x20u : 0u));
+    t.regs()[15] = target & ~1u;
+}
+
+void h_hook(int id, GuestThread& t) {
+    Hook h;
+    { std::lock_guard<std::mutex> l(g_mu); h = g_hooks[id]; }
+    bool nested = false;
+    for (int x : t_in_cb) if (x == id) { nested = true; break; }
+    if (!h.live || nested || !h.cb) { jump(t, h.tramp); return; }
+    u32 r[17]; regs_out(t, r);
+    t_in_cb.push_back(id);
+    const int act = h.cb(id, 0, r);
+    t_in_cb.pop_back();
+    regs_in(t, r);
+    if (act == 1) { jump(t, r[14]); return; }            // replaced: back to the caller
+    if (act == 2) {                                      // run the original, then see its return
+        t_leave.push_back({r[14], id, r[13]});
+        t.regs()[14] = g_arena;                          // the original returns into the leave stub
+    }
+    jump(t, h.tramp);
+}
+
+void h_leave(GuestThread& t) {
+    const u32 sp = t.regs()[13];
+    while (!t_leave.empty() && t_leave.back().sp < sp) t_leave.pop_back();
+    if (t_leave.empty()) { log("windstock: hook leave with nothing pending"); jump(t, 0); return; }
+    const Pending p = t_leave.back(); t_leave.pop_back();
+    HookCb cb; { std::lock_guard<std::mutex> l(g_mu); cb = g_hooks[p.id].cb; }
+    u32 r[17]; regs_out(t, r);
+    r[14] = p.lr;
+    if (cb) { t_in_cb.push_back(p.id); cb(p.id, 1, r); t_in_cb.pop_back(); }
+    regs_in(t, r);
+    jump(t, p.lr);
+}
+
+// ---- calling the guest ----
+std::optional<GuestResult> call(u32 fn, const u32* args, int n) {
+    GuestCall c;
+    for (int i = 0; i < n; ++i) { if (i < 4) c.regs[i] = args[i]; else c.stack.push_back(args[i]); }
+    if (auto r = g_rt->call_on_current(fn, c)) return r;
+    return g_rt->call_on_service(fn, c);
+}
+
+std::mutex g_sym_mu;
+std::map<std::string, u32> g_handles;
+
+u32 lib_handle(const std::string& lib) {
+    std::lock_guard<std::mutex> l(g_sym_mu);
+    auto it = g_handles.find(lib);
+    if (it != g_handles.end()) return it->second;
+    std::string err;
+    const u32 h = g_rt->load_library(lib, ZB_GUEST_RTLD_NOW, err);
+    if (!h) { log("windstock: dlopen(%s) failed: %s", lib.c_str(), err.c_str()); return 0; }
+    g_handles[lib] = h;
+    return h;
+}
+
+u32 sym(const char* lib, const char* name) {
+    const u32 h = lib_handle(lib);
+    if (!h) return 0;
+    std::string err;
+    return g_rt->find_symbol(h, name, err);
+}
+
+}  // namespace
+
+void windstock_guest_started(LibraryRuntime* runtime) {
+    g_rt = runtime;
+    log("windstock: guest hook layer ready");
+}
+
+bool windstock_handle_host_call(u32 index, GuestThread& thread) {
+    if (index < kLeaveIndex || index > kLeaveIndex + kMaxHooks + 1) return false;
+    if (index == kLeaveIndex) h_leave(thread);
+    else h_hook(int(index - kLeaveIndex - 1), thread);
+    return true;
+}
+
+}  // namespace zb
+
+using namespace zb;
+
+#define WST_EXPORT extern "C" __attribute__((visibility("default")))
+
+WST_EXPORT void* wst_gbase() { return g_rt ? mem().base() : nullptr; }
+
+WST_EXPORT uint64_t wst_gcall(uint32_t fn, const uint32_t* args, int n) {
+    if (!g_rt) return 0;
+    auto r = call(fn, args, n);
+    return r ? (uint64_t(r->r1) << 32) | r->r0 : 0;
+}
+
+WST_EXPORT uint32_t wst_gsym(const char* lib, const char* name) { return g_rt ? sym(lib, name) : 0; }
+
+WST_EXPORT int wst_gmodule(const char* lib, uint32_t* base, uint32_t* size) {
+    return g_rt && g_rt->process().module_range(lib, base, size) ? 1 : 0;
+}
+
+WST_EXPORT uint32_t wst_galloc(uint32_t n) {
+    static u32 calloc_fn = 0;
+    if (!calloc_fn) calloc_fn = sym("libc.so", "calloc");
+    if (!calloc_fn) return 0;
+    const u32 a[2] = {1, n ? n : 1};
+    auto r = call(calloc_fn, a, 2);
+    return r ? r->r0 : 0;
+}
+
+WST_EXPORT void wst_gfree(uint32_t p) {
+    static u32 free_fn = 0;
+    if (!free_fn) free_fn = sym("libc.so", "free");
+    if (free_fn && p) call(free_fn, &p, 1);
+}
+
+WST_EXPORT int wst_ghook(uint32_t addr, HookCb cb, int leave) {
+    if (!g_rt) return -1;
+    std::lock_guard<std::mutex> l(g_mu);
+    for (auto& h : g_hooks)
+        if (h.addr == addr && h.live) { log("windstock: %08x already hooked", addr & ~1u); return -1; }
+    if (g_hooks.size() >= kMaxHooks) return -1;
+    // A function that is just `B target` (a jump stub, often 4 bytes with another stub right after
+    // it) cannot take our 8-byte patch without destroying its neighbour: hook where it jumps to.
+    for (int hop = 0; hop < 4 && !(addr & 1); ++hop) {
+        const u32 ins = rd32(addr);
+        if ((ins & 0xFF000000) != 0xEA000000) break;
+        const u32 to = addr + 8 + u32(int32_t(ins << 8) >> 6);
+        log("windstock: %08x is a jump stub -> hooking %08x", addr, to);
+        addr = to;
+    }
+    for (auto& h : g_hooks)
+        if (h.addr == addr && h.live) return h.addr == addr ? -1 : -1;
+    Hook h; h.addr = addr; h.cb = cb; h.leave = leave != 0;
+    u32 len = 0;
+    h.tramp = build_tramp(addr, &len);
+    if (!h.tramp) { log("windstock: %08x (%s): entry not relocatable: %08x %08x", addr & ~1u, (addr & 1) ? "thumb" : "arm", rd32(addr & ~1u), rd32((addr & ~1u) + 4)); return -1; }
+    const int id = int(g_hooks.size());
+    const u32 stub = arena_alloc(4);
+    if (!stub) return -1;
+    const u32 svc = 0xEF000000u | (0x5A0000u | (kLeaveIndex + 1 + id));
+    gwrite(stub, &svc, 4);
+    h.stub = stub;
+    const u32 pc = addr & ~1u;
+    h.saved_len = len;
+    std::memcpy(h.saved, H(pc), len);
+    if (addr & 1) {
+        // LDR.W PC, [PC, #lit]: the literal sits at pc+4 (base is pc aligned down to 4)
+        u8 patch[8];
+        const u16 a0 = 0xF8DF, a1 = (pc & 2) ? 0xF002 : 0xF000;
+        std::memcpy(patch, &a0, 2); std::memcpy(patch + 2, &a1, 2); std::memcpy(patch + 4, &stub, 4);
+        gwrite(pc, patch, 8);
+    } else {
+        const u32 w[2] = {0xE51FF004u, stub};
+        gwrite(pc, w, 8);
+    }
+    for (u32 k = 8; k < len; k += 2) { u16 nop = 0xBF00; gwrite(pc + k, &nop, 2); }
+    h.live = true;
+    g_hooks.push_back(h);
+    g_rt->process().invalidate(pc, len < 8 ? 8 : len);
+    log("windstock: hook #%d at %08x (%s, %u bytes moved)", id, pc, (addr & 1) ? "thumb" : "arm", len);
+    return id;
+}
+
+WST_EXPORT uint32_t wst_ghook_orig(int id) {
+    std::lock_guard<std::mutex> l(g_mu);
+    return id >= 0 && id < int(g_hooks.size()) ? g_hooks[id].tramp : 0;
+}
+
+WST_EXPORT void wst_gunhook(int id) {
+    std::lock_guard<std::mutex> l(g_mu);
+    if (id < 0 || id >= int(g_hooks.size()) || !g_hooks[id].live) return;
+    Hook& h = g_hooks[id];
+    const u32 pc = h.addr & ~1u;
+    gwrite(pc, h.saved, h.saved_len);
+    h.live = false;
+    g_rt->process().invalidate(pc, h.saved_len);
+}
+
+// True once the guest's il2cpp runtime is fully up (il2cpp_init has returned): the moment the
+// Windstock agent may start calling into it, before Unity draws its first frame. The domain
+// exists long before that (il2cpp_init creates it first), so it is not a sign of readiness: a
+// leave-hook on il2cpp_init says when init is over. If init was already running when we first
+// looked, the hook cannot see its end; then the domain staying up for 5 s has to do.
+static std::atomic<int> g_init_hook{-2};      // -2 not tried, -1 failed, >=0 hook id
+static std::atomic<bool> g_init_left{false};
+static std::atomic<int64_t> g_domain_since{0};
+
+static int init_cb(int, int kind, u32*) {
+    if (kind == 0) return 2;                  // run the original and tell me when it returns
+    g_init_left = true;
+    return 0;
+}
+
+extern "C" __attribute__((visibility("default"))) jboolean
+Java_com_windstock_translator64_WsHooks_nGuestReady(void*, void*) {
+    if (!g_rt) return 0;
+    uint32_t base, size;
+    if (!g_rt->process().module_range("libil2cpp.so", &base, &size)) return 0;
+    static u32 dom = 0, init = 0;
+    if (!dom) dom = sym("libil2cpp.so", "il2cpp_domain_get");
+    if (!init) init = sym("libil2cpp.so", "il2cpp_init");
+    if (!dom || !init) return 0;
+    if (g_init_left) {
+        int id = g_init_hook.exchange(-1);
+        if (id >= 0) wst_gunhook(id);         // the agent hooks il2cpp_init itself when it is early
+        return 1;
+    }
+    auto r = call(dom, nullptr, 0);
+    const bool has_domain = r && r->r0 != 0;
+    if (g_init_hook == -2 && !has_domain) g_init_hook = wst_ghook(init, init_cb, 1);
+    if (!has_domain) return 0;
+    if (g_init_hook >= 0 || g_init_hook == -2) {
+        // hooked before init ran: wait for the leave
+        return 0;
+    }
+    const int64_t now = std::chrono::duration_cast<std::chrono::milliseconds>(
+        std::chrono::steady_clock::now().time_since_epoch()).count();
+    int64_t zero = 0;
+    g_domain_since.compare_exchange_strong(zero, now);
+    return now - g_domain_since >= 5000;
+}
